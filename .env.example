# Supabase project URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe to expose to the browser).
# This is the ONLY key the frontend uses.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site URL, used for canonical/Open Graph metadata (safe to expose).
# Example: https://alsaharesto.com
NEXT_PUBLIC_SITE_URL=

# SECURITY:
# - Never add a service_role key to this file or any NEXT_PUBLIC_ variable.
# - Authorization is enforced by Supabase Row Level Security (RLS).
